POSTGRES_DB=test_manager
POSTGRES_USER=test_manager
POSTGRES_PASSWORD=replace-with-strong-database-password

APP_ENV=production
SEED_DEMO_DATA=false
DATABASE_URL=postgresql+psycopg://test_manager:replace-with-strong-database-password@postgres:5432/test_manager

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
DOCS_ENABLED=false

CORS_ORIGINS=["https://test-manager.example.com"]
FRONTEND_PORT=80
