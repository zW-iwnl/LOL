# Public hostname. The DNS A/AAAA record must point to the Linux server.
DOMAIN=test-manager.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=test_manager
POSTGRES_USER=test_manager
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-database-password
DATABASE_URL=postgresql+psycopg://test_manager:replace-with-a-strong-alphanumeric-database-password@postgres:5432/test_manager

APP_ENV=production
SEED_DEMO_DATA=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
DOCS_ENABLED=false
UVICORN_WORKERS=2

# Keep this on the same public origin used in DOMAIN.
CORS_ORIGINS=["https://test-manager.example.com"]
