server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    # Railway private networking can be IPv6-only in legacy environments.
    # Keep both A and AAAA lookups enabled so the backend remains reachable
    # in Docker Compose as well as on Railway.
    resolver 127.0.0.11 valid=10s;

    set $backend ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass $backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
